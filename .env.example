# === Supabase (public, safe to expose to the browser) ===
# Found in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# === Supabase (SECRET - server-side only, never exposed to the browser) ===
# Used only inside server components / route handlers.
# NEVER prefix this with NEXT_PUBLIC_. NEVER import it into client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === App ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Google Drive Backup ===
# Required for Google Drive backup feature (OAuth 2.0 Client ID)
# Create at: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
